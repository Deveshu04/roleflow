# Required. Used for resume parsing, job matching, resume tailoring, web job search and the browser agent.
OPENAI_API_KEY=

# Optional model overrides (defaults: gpt-5.5 for everything).
# OPENAI_MODEL=gpt-5.5
# Model that drives the browser agent; a smaller model (e.g. gpt-5.4-mini) is cheaper but less reliable on tricky forms.
# OPENAI_AGENT_MODEL=gpt-5.5

# Browser the agent drives: chrome (installed Google Chrome, default), msedge, or chromium (Playwright's bundled build).
# BROWSER_CHANNEL=chrome
# Set to true to hide the agent's browser window (you then can't sign in or solve CAPTCHAs when it pauses).
# HEADLESS=false
# Safety caps per application: model steps, and input tokens (the run stops and leaves the tab open).
# AGENT_MAX_STEPS=40
# AGENT_MAX_RUN_TOKENS=150000
